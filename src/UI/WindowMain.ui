  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget { background: #f5f6f7; color: #24272b; }
QLabel, QCheckBox { color: #24272b; }
QLineEdit, QComboBox, QDoubleSpinBox {
 background: #ffffff; color: #24272b; border: 1px solid #c6cbd0;
 border-radius: 4px; padding: 4px 8px; selection-background-color: #087e72;
}
QLineEdit[readOnly="true"] { background: #edf0f2; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus { border-color: #087e72; }
QLineEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled { background: #edf0f2; color: #747b82; }
QComboBox QAbstractItemView { background: #ffffff; color: #24272b; selection-background-color: #e1f1ed; selection-color: #175d52; }
QPushButton { background: #ffffff; color: #24272b; border: 1px solid #b9c0c5; border-radius: 4px; padding: 6px 12px; }
QPushButton:hover { background: #edf5f3; border-color: #087e72; }
QPushButton:pressed, QPushButton:checked { background: #e1f1ed; border-color: #087e72; color: #175d52; }
QPushButton:focus { border: 2px solid #087e72; padding: 5px 11px; }
QPushButton:disabled { background: #edf0f2; color: #747b82; border-color: #d6dade; }
QTableWidget { background: #ffffff; alternate-background-color: #f7f9fa; color: #24272b; border: 1px solid #d3d8dd; gridline-color: #edf0f2; }
QTableWidget::item { padding: 4px; }
QTableWidget::item:selected { background: #e1f1ed; color: #175d52; }
QHeaderView::section { background: #edf0f2; color: #454d55; padding: 6px 4px; border: none; border-bottom: 1px solid #d3d8dd; }
QMenuBar { background: #f5f6f7; color: #24272b; }
QMenuBar::item { padding: 6px 12px; }
QMenuBar::item:selected { background: #e1f1ed; }
QMenu { background: #ffffff; color: #24272b; }
QMenu::item:selected { background: #e1f1ed; color: #175d52; }
QLabel#label_3, QLabel#label_2, QLabel#label_4 { color: #626b73; }
QFrame#footerSeparator { color: #d3d8dd; }</string>
